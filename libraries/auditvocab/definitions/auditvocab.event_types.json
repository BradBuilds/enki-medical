{
  "id": "audit_vocab.event_types",
  "type": "custom",
  "version": "0.1.0",
  "description": "Canonical audit event type vocabulary",
  "content": {
    "category": "event_types",
    "purpose": "Defines the canonical types of audit events in ENKI systems",
    "event_types": [
      {
        "event_type_id": "assertion.proposed",
        "label": "Assertion Proposed",
        "category": "assertion_lifecycle",
        "description": "A new assertion has been proposed or submitted",
        "typical_fields": ["actor_id", "assertion_id", "timestamp", "scope"],
        "notes": ["Marks the beginning of assertion lifecycle", "Does not imply acceptance or validation"]
      },
      {
        "event_type_id": "assertion.accepted",
        "label": "Assertion Accepted",
        "category": "assertion_lifecycle",
        "description": "An assertion has been accepted into the system",
        "typical_fields": ["actor_id", "assertion_id", "timestamp", "scope"],
        "notes": ["Assertion passed initial checks", "May still require validation"]
      },
      {
        "event_type_id": "assertion.rejected",
        "label": "Assertion Rejected",
        "category": "assertion_lifecycle",
        "description": "An assertion has been rejected due to validation failure",
        "typical_fields": ["actor_id", "assertion_id", "timestamp", "reason"],
        "notes": ["Assertion failed validation", "Reason should indicate why"]
      },
      {
        "event_type_id": "assertion.validated",
        "label": "Assertion Validated",
        "category": "assertion_lifecycle",
        "description": "An assertion has been validated against vocabulary packs",
        "typical_fields": ["assertion_id", "timestamp", "validator"],
        "notes": ["Assertion passed all validation checks", "Ready for use"]
      },
      {
        "event_type_id": "assertion.invalidated",
        "label": "Assertion Invalidated",
        "category": "assertion_lifecycle",
        "description": "A previously valid assertion has been marked invalid",
        "typical_fields": ["assertion_id", "timestamp", "reason"],
        "notes": ["Assertion no longer considered valid", "May be due to vocabulary changes"]
      },
      {
        "event_type_id": "pack.loaded",
        "label": "Pack Loaded",
        "category": "pack_operations",
        "description": "A definition pack has been successfully loaded",
        "typical_fields": ["pack_id", "version", "timestamp", "node_id"],
        "notes": ["Pack validation succeeded", "Definitions are available"]
      },
      {
        "event_type_id": "pack.validation_failed",
        "label": "Pack Validation Failed",
        "category": "pack_operations",
        "description": "A definition pack failed validation",
        "typical_fields": ["pack_id", "timestamp", "errors", "node_id"],
        "notes": ["Pack could not be loaded", "Errors should be logged"]
      },
      {
        "event_type_id": "pack.unloaded",
        "label": "Pack Unloaded",
        "category": "pack_operations",
        "description": "A definition pack has been unloaded from memory",
        "typical_fields": ["pack_id", "version", "timestamp", "node_id"],
        "notes": ["Pack definitions no longer available"]
      },
      {
        "event_type_id": "node.started",
        "label": "Node Started",
        "category": "node_lifecycle",
        "description": "An ENKI node has started up",
        "typical_fields": ["node_id", "timestamp", "version"],
        "notes": ["Initial startup event", "Node is initializing"]
      },
      {
        "event_type_id": "node.heartbeat",
        "label": "Node Heartbeat",
        "category": "node_lifecycle",
        "description": "Periodic heartbeat indicating node is running",
        "typical_fields": ["node_id", "timestamp", "status"],
        "notes": ["Regular health check", "Confirms node is active"]
      },
      {
        "event_type_id": "node.stopped",
        "label": "Node Stopped",
        "category": "node_lifecycle",
        "description": "An ENKI node has shut down",
        "typical_fields": ["node_id", "timestamp", "reason"],
        "notes": ["Graceful or unexpected shutdown"]
      },
      {
        "event_type_id": "usage.meter_tick",
        "label": "Usage Meter Tick",
        "category": "usage_tracking",
        "description": "Periodic usage metering event",
        "typical_fields": ["node_id", "timestamp", "metrics"],
        "notes": ["Resource usage tracking", "For future billing/analytics"]
      },
      {
        "event_type_id": "validation.started",
        "label": "Validation Started",
        "category": "validation_operations",
        "description": "Validation process has begun",
        "typical_fields": ["target_id", "target_type", "timestamp"],
        "notes": ["Marks start of validation workflow"]
      },
      {
        "event_type_id": "validation.completed",
        "label": "Validation Completed",
        "category": "validation_operations",
        "description": "Validation process has completed successfully",
        "typical_fields": ["target_id", "target_type", "timestamp", "result"],
        "notes": ["Validation finished without errors"]
      },
      {
        "event_type_id": "validation.failed",
        "label": "Validation Failed",
        "category": "validation_operations",
        "description": "Validation process encountered errors",
        "typical_fields": ["target_id", "target_type", "timestamp", "errors"],
        "notes": ["Validation found issues", "Errors should be detailed"]
      }
    ],
    "notes": [
      "Event types are vocabulary only - no processing logic",
      "Typical fields are suggestions, not requirements",
      "Future systems may extend with additional event types"
    ]
  },
  "metadata": {
    "created": "2025-12-31T00:00:00Z",
    "author": "ENKI System"
  },
  "dependencies": ["audit_vocab.system"]
}

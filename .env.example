# Copy to .env and fill in. .env is never committed.

# Database password for the bundled PostgreSQL. Use a long random value.
POSTGRES_PASSWORD=change-me

# Protects the node's root signing key. Use a long random value and keep it safe:
# without it the root key in enki-data/keys cannot be opened.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ENKI_ROOT_PASSWORD=change-me

# Tenant ids your admin device may manage (lowercase, digits, hyphens; comma-separated).
ENKI_TENANTS=demo-tenant

# Your own libraries (see docs/BUILD_A_LIBRARY.md). Leave as is until you admit one.
ENKI_ACTIVE_SET=active_set_v3.json
ENKI_EVENT_LIBRARIES=

# Port on your machine (the API listens on 127.0.0.1 only).
ENKI_PORT=8000

# Your user and group id, so files in ./enki-data belong to you (run `id -u` and `id -g`).
ENKI_UID=1000
ENKI_GID=1000
